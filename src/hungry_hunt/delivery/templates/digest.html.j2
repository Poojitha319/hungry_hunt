{% macro job_row(j) -%}
<tr>
  <td style="padding:10px 8px;border-bottom:1px solid #e5e7eb;vertical-align:top;">
    <div style="font-weight:600;color:#111827;">{{ j.title }}</div>
    <div style="color:#374151;">{{ j.company }}
      <span style="font-size:11px;background:#eef2ff;color:#3730a3;border-radius:4px;padding:1px 6px;margin-left:4px;">{{ j.tier.replace('_', ' ') }}</span>
      {% if j.recently_funded %}<span style="font-size:11px;background:#fef3c7;color:#92400e;border-radius:4px;padding:1px 6px;margin-left:4px;">recently funded</span>{% endif %}
      {% if j.company_velocity >= 3 %}<span style="font-size:11px;background:#ecfdf5;color:#047857;border-radius:4px;padding:1px 6px;margin-left:4px;">hiring fast · {{ j.company_velocity }} junior roles this fortnight</span>{% endif %}
      {% if j.location_raw %}· {{ j.location_raw }}{% endif %}
      {% if j.posted_age_days is not none %}· posted {{ j.posted_age_days }}d ago{% endif %}
    </div>
    {% if j.reason %}<div style="color:#4b5563;margin-top:4px;">{{ j.reason }}</div>{% endif %}
    {% if j.years_evidence %}<div style="color:#6b7280;font-size:12px;margin-top:4px;">“{{ j.years_evidence }}”</div>{% endif %}
    {% if j.breakdown %}<div style="color:#6b7280;font-size:11px;margin-top:4px;">skills {{ j.breakdown.skills_overlap }}/40 · seniority {{ j.breakdown.seniority_fit }}/25 · domain {{ j.breakdown.domain_fit }}/20 · practical {{ j.breakdown.practical_fit }}/15</div>{% endif %}
  </td>
  <td style="padding:10px 8px;border-bottom:1px solid #e5e7eb;text-align:center;vertical-align:top;white-space:nowrap;">
    {% if j.score is not none %}<div style="font-size:20px;font-weight:700;color:{{ '#047857' if j.verdict == 'apply' else '#b45309' }};">{{ j.score }}</div>
    <div style="font-size:11px;text-transform:uppercase;color:#6b7280;">{{ j.verdict }}</div>{% endif %}
  </td>
  <td style="padding:10px 8px;border-bottom:1px solid #e5e7eb;vertical-align:top;white-space:nowrap;">
    <a href="{{ j.url }}" style="display:inline-block;background:#111827;color:#fff;text-decoration:none;padding:6px 10px;border-radius:6px;font-size:13px;">Apply</a><br>
    <a href="{{ j.review_url }}" style="font-size:12px;color:#4f46e5;">Review</a>
  </td>
</tr>
{%- endmacro %}
{% macro compact_row(j) -%}
<li style="margin:5px 0;"><a href="{{ j.url }}" style="color:#111827;font-weight:600;">{{ j.title }}</a> · {{ j.company }}{% if j.location_raw %} · {{ j.location_raw }}{% endif %}
 · <span style="color:#b45309;font-weight:600;">{{ j.score }}</span> · <a href="{{ j.review_url }}" style="color:#4f46e5;">review</a></li>
{%- endmacro %}
{% macro section_table(groups) -%}
{% for s in sections if s != 'Stretch' and groups[s] %}
{% set top = groups[s]|selectattr('verdict', 'equalto', 'apply')|list %}{% set rest = groups[s]|rejectattr('verdict', 'equalto', 'apply')|list %}
<h3 style="margin:18px 0 6px;color:#111827;">{{ s }} <span style="color:#6b7280;font-weight:400;">({{ groups[s]|length }})</span></h3>
{% if top %}<table style="width:100%;border-collapse:collapse;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:14px;">
{% for j in top %}{{ job_row(j) }}{% endfor %}
</table>{% endif %}
{% if rest %}<div style="margin:10px 0 2px;font-size:13px;color:#6b7280;">Worth a look ({{ rest|length }})</div>
<ul style="margin:0;padding-left:18px;font-size:13px;">{% for j in rest %}{{ compact_row(j) }}{% endfor %}</ul>{% endif %}
{% endfor %}
{%- endmacro %}
<!doctype html>
<html><body style="margin:0;padding:16px;background:#f9fafb;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#111827;">
<div style="max-width:720px;margin:0 auto;background:#fff;border-radius:8px;padding:20px;">
<h2 style="margin:0 0 4px;">Hungry Hunt · {{ d.date_ist }}</h2>
<div style="color:#6b7280;margin-bottom:12px;">{{ n_new }} new · {{ n_carried }} carried · {{ d.unscored|length }} unscored{% if d.truncated %} · +{{ d.truncated }} more on the <a href="{{ review_base }}/?t={{ token }}" style="color:#4f46e5;">review page</a> (they roll over){% endif %}</div>

{% if n_new == 0 and n_carried == 0 and not d.unscored %}
<p style="padding:16px;background:#f3f4f6;border-radius:6px;">No genuine openings today. The system ran; coverage is below.</p>
{% endif %}

{% if n_new %}<h2 style="margin:16px 0 0;font-size:16px;color:#047857;">New since yesterday</h2>{{ section_table(d.new) }}{% endif %}
{% if n_carried %}<h2 style="margin:20px 0 0;font-size:16px;color:#6b7280;">Still open, not yet acted on</h2>{{ section_table(d.carried) }}{% endif %}

{% if d.unscored %}
<h2 style="margin:20px 0 6px;font-size:16px;color:#b45309;">Unscored — passed the rules, Gemini quota was hit</h2>
<ul style="margin:0;padding-left:18px;font-size:14px;">
{% for j in d.unscored %}<li style="margin:4px 0;"><a href="{{ j.url }}" style="color:#111827;">{{ j.title }}</a> · {{ j.company }}{% if j.location_raw %} · {{ j.location_raw }}{% endif %} · <a href="{{ j.review_url }}" style="color:#4f46e5;">review</a></li>{% endfor %}
</ul>
{% endif %}

{% if d.pipeline %}{% set w = d.pipeline.week %}{% set t = d.pipeline.total %}
<hr style="border:0;border-top:1px solid #e5e7eb;margin:24px 0 12px;">
<div style="font-size:13px;color:#374151;line-height:1.6;">
<strong>Your pipeline</strong> (from hiring mail forwarded to the agent)<br>
Last 7 days: {{ w.applied }} applied · {{ w.test }} test · {{ w.interview }} interview · {{ w.rejected }} rejected<br>
All time: {{ t.applied }} applied · {{ t.test }} test · {{ t.interview }} interview · {{ t.rejected }} rejected
</div>
{% endif %}
<hr style="border:0;border-top:1px solid #e5e7eb;margin:24px 0 12px;">
<div style="font-size:12px;color:#6b7280;line-height:1.6;">
<strong>Coverage</strong><br>
{% set c = d.coverage %}
{% if c.stats_available %}{{ c.boards_ok }}/{{ c.boards_total }} boards · {{ c.jobs_new }} new postings · {{ c.gemini_calls }} scored{% if c.quota_hit %} · <span style="color:#b45309;">quota hit, {{ c.unscored }} scored tomorrow</span>{% endif %}<br>
{% else %}Pipeline stats unavailable for today (fetch did not record a run).<br>{% endif %}
{% if c.blind_spots %}Blind spots (check manually): {{ c.blind_spots|join(', ') }}<br>{% endif %}
{% if c.stale_targets %}Stale boards: {{ c.stale_targets|join(', ') }}<br>{% endif %}
{% if c.stale_hidden %}{{ c.stale_hidden }} hidden as stale (posted too long ago)<br>{% endif %}
{% if c.funded_unwatched %}Recently funded, not watched yet: {{ c.funded_unwatched|join(', ') }}<br>{% endif %}
Review links open the app; first click may take ~30 s while the server wakes.
</div>
</div></body></html>
