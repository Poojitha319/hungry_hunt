# Local default is SQLite; on Neon use the pooled URL: postgresql+psycopg://user:pass@host-pooler.neon.tech/db?sslmode=require
DATABASE_URL=sqlite:///hunt.db
USER_ID=me

# Google AI Studio key; free-tier Flash model (check the exact id and limits shown in AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSESS_MAX_CALLS=300
ASSESS_INTERVAL_S=6.2

# Gmail: enable 2-Step Verification, then create an App Password
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Review app: where the SPA is served, and the shared token embedded in email links
REVIEW_BASE_URL=http://localhost:5173
REVIEW_TOKEN=

DIGEST_MAX_JOBS=120
FETCH_CONCURRENCY=24
FETCH_PER_HOST=16
MAX_YEARS_BAR=2
MAX_POSTED_AGE_DAYS=14
RESUME_TEX=./resume.tex

# plain for a terminal, json for log collectors
LOG_LEVEL=INFO
LOG_FORMAT=plain
